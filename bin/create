#!/bin/sh
# create: start and run Create projects. Everything is done by pixi.
set -eu

# Replaced with the release's version when the package is built (see
# recipe/recipe.yaml), so the git tag is the one place it is set.
VERSION="dev"

# The channels a project needs: Mojo from Modular's, Create from
# modular-community, and its native libraries from conda-forge.
CHANNELS="https://conda.modular.com/max https://repo.prefix.dev/modular-community conda-forge"

# The platforms Create supports; listing both lets a project made on one solve
# on the other.
PLATFORMS="linux-64 osx-arm64"

GUIDE="https://github.com/create-framework/create/blob/main/docs/README.md"

nl='
'

# Colour only on a terminal, and never with NO_COLOR set (https://no-color.org).
color_out=
color_err=
if [ -z "${NO_COLOR:-}" ]; then
    if [ -t 1 ]; then color_out=1; fi
    if [ -t 2 ]; then color_err=1; fi
fi

# paint <on> <sgr> <text>
paint() {
    if [ -n "$1" ]; then
        printf '\033[%sm%s\033[0m' "$2" "$3"
    else
        printf '%s' "$3"
    fi
}

die() {
    printf '%s %s\n' "$(paint "$color_err" '1;31' 'create:')" "$1" >&2
    exit 1
}

step() {
    printf '%s %s\n' "$(paint "$color_out" '1;32' '==>')" "$1"
}

usage() {
    cat <<EOF
create $VERSION: start and run Create projects

Usage:
  create new <path>        Make a project at <path> with mojo, create and a main.mojo
  create run [args...]     Run the project's main.mojo, passing args to the program
  create --version         Print the version
  create --help            Print this help

'create <command> --help' tells more about a command.

The user guide: $GUIDE
To update: pixi global update create-cli
EOF
}

usage_new() {
    cat <<EOF
Usage: create new [--verbose] <path>

Makes a project at <path>, which must not exist or be an empty directory
('create new .' makes one in the current directory). The project is a pixi
project with the Modular, modular-community and conda-forge channels, for
Linux (x86-64) and macOS (Apple silicon), with the mojo and create packages
and a main.mojo to start from. If a step fails, nothing is left behind.

Options:
  -v, --verbose   Show pixi's output
  -h, --help      Print this help
EOF
}

usage_run() {
    cat <<EOF
Usage: create run [args...]

Runs the project's main.mojo, from anywhere inside the project, passing args to
the program: 'create run gpu' runs it on the GPU backend. The program runs in
the project's directory, so paths it opens are relative to the project.

To pass --help to the program, put '--' first: create run -- --help
EOF
}

require_pixi() {
    command -v pixi >/dev/null 2>&1 \
        || die "pixi is not installed; see https://pixi.sh"
}

# The pixi platform of this machine, if Create supports it.
host_platform() {
    case "$(uname -s) $(uname -m)" in
        "Linux x86_64") echo linux-64 ;;
        "Darwin arm64") echo osx-arm64 ;;
        *) return 1 ;;
    esac
}

require_platform() {
    host_platform >/dev/null \
        || die "Create runs on Linux (x86-64) and macOS (Apple silicon), not on $(uname -s) $(uname -m)"
}

# Single quotes <text> for a shell when it needs them.
shell_quote() {
    case $1 in
        *[!A-Za-z0-9_./+-]* | '') printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
        *) printf '%s' "$1" ;;
    esac
}

# <text> as the inside of a Mojo string literal.
mojo_string() {
    printf '%s' "$1" | sed 's/[\\"]/\\&/g'
}

# The template for main.mojo; $1 is the window's title, already escaped.
main_mojo() {
    cat <<EOF
# See $GUIDE to get started

from create import *


@fieldwise_init
struct MyApp(Program):

    @staticmethod
    def create(mut context: Context, mut canvas: Canvas) raises -> MyApp:
        # Called once: set initial application state and draw the first frame
        return MyApp()

    def update(mut self, mut context: Context, mut canvas: Canvas) raises:
        # Called once per frame: handle input, modify state and draw to the screen
        pass


def main() raises:
    run[MyApp]("$1")
EOF
}

# quietly <command...>: runs it with its output kept in $log, and shows that
# output if it fails. With --verbose the output is shown as it happens.
quietly() {
    if [ -n "$verbose" ]; then
        "$@"
        return
    fi
    "$@" >"$log" 2>&1 || {
        status=$?
        cat "$log" >&2
        return "$status"
    }
}

# Empties the project directory after a failed `create new`: removes it if
# the command made it, or just its contents if it was already there.
undo_new() {
    rm -f "$log"
    if [ -n "$made_dir" ]; then
        rm -rf -- "$path"
    elif [ -d "$path" ]; then
        (cd "$path" && rm -rf -- ./* ./.[!.]* ./..?*)
    fi
}

cmd_new() {
    verbose=
    path=
    paths=0
    options=1
    for arg; do
        if [ -n "$options" ]; then
            case $arg in
                -h | --help) usage_new; exit 0 ;;
                -v | --verbose) verbose=1; continue ;;
                --) options=; continue ;;
                -*) die "unknown option '$arg'; see 'create new --help'" ;;
            esac
        fi
        path=$arg
        paths=$((paths + 1))
    done
    [ "$paths" -eq 1 ] || die "usage: create new [--verbose] <path>"
    case $path in
        '') die "the path is empty" ;;
        *"$nl"*) die "the path has a line break in it" ;;
    esac
    # Drop trailing slashes, but keep / itself.
    while :; do
        case $path in
            ?*/) path=${path%/} ;;
            *) break ;;
        esac
    done

    if [ -e "$path" ]; then
        [ -d "$path" ] || die "'$path' already exists"
        [ -z "$(ls -A "$path")" ] || die "'$path' already exists and is not empty"
        [ -w "$path" ] || die "'$path' is not writable"
        made_dir=
        title=$(cd -- "$path" && pwd -P)
        title=${title##*/}
    else
        made_dir=1
        title=${path##*/}
    fi
    require_pixi
    require_platform

    set --
    for channel in $CHANNELS; do set -- "$@" --channel "$channel"; done
    for platform in $PLATFORMS; do set -- "$@" --platform "$platform"; done

    # A half-made project is removed, so the command can simply be rerun.
    log=$(mktemp)
    trap undo_new EXIT
    trap 'exit 130' INT TERM

    step "Making $title"
    quietly pixi init "$@" -- "$path" \
        || die "could not make the project: pixi init failed"
    step "Adding Mojo and Create (the first time, this downloads Mojo and can take a few minutes)"
    quietly pixi add --manifest-path "$path/pixi.toml" mojo create \
        || die "could not add mojo and create: pixi add failed"
    main_mojo "$(mojo_string "$title")" >"$path/main.mojo"

    trap - EXIT INT TERM
    rm -f "$log"

    printf '\nMade %s. To run it:\n\n' "$title"
    [ "$path" = . ] || printf '  cd %s\n' "$(shell_quote "$path")"
    printf '  create run\n\n'
}

# The nearest directory at or above the current one with a pixi.toml and a
# main.mojo; directories with only a pixi.toml, like an enclosing workspace,
# are passed over.
project_root() {
    dir=$(pwd -P)
    while :; do
        if [ -f "$dir/pixi.toml" ] && [ -f "$dir/main.mojo" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        [ "$dir" != / ] || return 1
        dir=$(dirname "$dir")
    done
}

require_project() {
    project_root \
        || die "not in a Create project: no pixi.toml with a main.mojo here or above"
}

# Skips a leading -h/--help (the command's own help) or -- (so the program
# gets everything after it); sets $skip to how many arguments to drop.
program_args() {
    skip=0
    case ${2-} in
        -h | --help) "$1"; exit 0 ;;
        --) skip=1 ;;
    esac
}

cmd_run() {
    program_args usage_run "$@"
    shift "$skip"
    require_pixi
    require_platform
    root=$(require_project)
    cd "$root"
    exec pixi run mojo run main.mojo "$@"
}

[ $# -gt 0 ] || { usage >&2; exit 1; }
command=$1
shift
case $command in
    new) cmd_new "$@" ;;
    run) cmd_run "$@" ;;
    -V | --version | version) printf 'create %s\n' "$VERSION" ;;
    -h | --help | help) usage ;;
    *) printf 'create: unknown command %s\n\n' "'$command'" >&2; usage >&2; exit 1 ;;
esac
