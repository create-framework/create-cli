#!/bin/sh
# create: start and run Create projects. Everything is done by pixi.
set -eu

# Replaced with the release's version when the package is built (see
# recipe/recipe.yaml), so the git tag is the one place it is set.
VERSION="dev"

# The channels a project needs: Mojo from Modular's, Create from its own
# (create-framework/create on prefix.dev, the one this CLI is on), and its
# native libraries from conda-forge.
CHANNELS="https://conda.modular.com/max https://prefix.dev/create-framework/create conda-forge"

# The platforms Create supports; listing both lets a project made on one solve
# on the other.
PLATFORMS="linux-64 osx-arm64"

# The Create releases the main.mojo template below is written for. New projects
# stay on these even after Create changes its API, so a CLI never makes a
# project that does not build. CI builds the template against the newest
# Create every week (tests/e2e.sh --latest); when that fails, update the
# template and this range together.
CREATE_SPEC="create>=0.2,<0.3"

# What `create watch` uses to rerun the program; pixi fetches it on first use.
WATCHEXEC_SPEC="watchexec>=2,<3"

GUIDE="https://create-framework.org/guide/"

# The files every new project starts with besides main.mojo, such as the logo
# it draws: share/create-cli/template beside bin/, in the checkout and in the
# installed package alike. A symlink to the script is followed to find it.
script=$0
while [ -L "$script" ]; do
    target=$(readlink "$script")
    case $target in
        /*) script=$target ;;
        *) script=$(dirname "$script")/$target ;;
    esac
done
TEMPLATE="$(cd "$(dirname "$script")/.." && pwd -P)/share/create-cli/template"

nl='
'

# The output style is in CONTRIBUTING.md. Each stream is coloured on a
# terminal, never with NO_COLOR set (https://no-color.org), and always with
# FORCE_COLOR set unless NO_COLOR is too.
color_out=
color_err=
if [ -z "${NO_COLOR:-}" ]; then
    case ${FORCE_COLOR:-} in '' | 0) force_color= ;; *) force_color=1 ;; esac
    if [ -n "$force_color" ] || [ -t 1 ]; then color_out=1; fi
    if [ -n "$force_color" ] || [ -t 2 ]; then color_err=1; fi
fi

# paint <on> <style> <text>: <text> in one of the output style's styles, if
# <on>; out and err decide <on> for their stream.
paint() {
    if [ -z "$1" ]; then
        printf '%s' "$3"
        return
    fi
    case $2 in
        step) sgr='1;34' ;;
        bold) sgr=1 ;;
        dim) sgr=2 ;;
        good) sgr=32 ;;
        warn) sgr='1;33' ;;
        bad) sgr='1;31' ;;
        command) sgr=36 ;;
    esac
    printf '\033[%sm%s\033[0m' "$sgr" "$3"
}

out() { paint "$color_out" "$1" "$2"; }
err() { paint "$color_err" "$1" "$2"; }

# Doctor's marks, where the locale can show them.
case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
    *UTF-8* | *utf-8* | *UTF8* | *utf8*) mark_good='✓' mark_note='–' mark_bad='✗' ;;
    *) mark_good='ok' mark_note='--' mark_bad='!!' ;;
esac

die() {
    printf '%s %s\n' "$(err bad 'create:')" "$1" >&2
    exit 1
}

step() {
    printf '%s %s\n' "$(out step '==>')" "$(out bold "$1")"
}

usage() {
    # A command in bold, padded to line up what it does.
    line() { printf '  %s %s\n' "$(out bold "$(printf '%-24s' "$1")")" "$2"; }
    printf 'create-cli %s: start and run Create projects\n\n' "$VERSION"
    printf '%s\n' "$(out bold Usage:)"
    line 'create new <path>' 'Create a new project at <path> with mojo, create and a main.mojo'
    line 'create run [args...]' "Run the project's main.mojo, passing args to the program"
    line 'create watch [args...]' 'Run main.mojo, and run it again whenever a .mojo file is saved'
    line 'create build [options]' 'Build main.mojo into an optimised program in build/'
    line 'create update' 'Update Mojo and Create within the versions the project allows'
    line 'create upgrade' 'Upgrade Mojo and Create beyond the versions the project allows'
    line 'create doctor' 'Check pixi, this machine and the project for problems'
    line 'create --version' 'Print the version'
    line 'create --help' 'Print this help'
    printf "\nRun '%s' for details.\n\n" "$(out command 'create <command> --help')"
    printf 'The user guide: %s\n' "$GUIDE"
    printf 'To update the CLI itself: %s\n' "$(out command 'pixi global update create-cli')"
}

usage_new() {
    cat <<EOF
$(out bold Usage:) create new [--verbose] <path>

Creates a new project at <path>, which must not exist or be an empty directory
('$(out command 'create new .')' creates one in the current directory). The project is a pixi
project with the Modular, Create and conda-forge channels, for
Linux (x86-64) and macOS (Apple silicon), with the mojo and create packages
and a main.mojo to start from, which draws the Create logo from
assets/logo.png. If a step fails, nothing is left behind.

$(out bold Options:)
  -v, --verbose   Show pixi's output
  -h, --help      Print this help
EOF
}

usage_run() {
    cat <<EOF
$(out bold Usage:) create run [args...]

Runs the project's main.mojo, from anywhere inside the project, passing args to
the program: '$(out command 'create run gpu')' runs it on the GPU backend. The program runs in
the project's directory, so paths it opens are relative to the project.

To pass --help to the program, put '--' first: $(out command 'create run -- --help')
EOF
}

usage_watch() {
    cat <<EOF
$(out bold Usage:) create watch [args...]

Runs the project's main.mojo like '$(out command 'create run')', and restarts it whenever a
.mojo file in the project is saved. Stop it with Ctrl-C. watchexec does the
watching; pixi downloads it the first time.

To pass --help to the program, put '--' first: $(out command 'create watch -- --help')
EOF
}

usage_build() {
    cat <<EOF
$(out bold Usage:) create build [mojo build options...]

Builds the project's main.mojo into a program at build/<project name>, which
runs without pixi or Mojo installed on the same platform. Options go to
'$(out command 'mojo build')': '$(out command 'create build -o app')' writes the program to ./app instead.
EOF
}

usage_update() {
    cat <<EOF
$(out bold Usage:) create update [--verbose]

Updates the project's packages, like Mojo and Create, from anywhere inside the
project, to the newest releases its pixi.toml allows, then shows how Mojo and
Create changed. The allowed versions stay as they are, so an update never
brings a Create release that could break the project's code. When a newer
Mojo or Create is out than they allow, it says so; '$(out command 'create upgrade')' upgrades
to it.

$(out bold Options:)
  -v, --verbose   Show pixi's output
  -h, --help      Print this help
EOF
}

usage_upgrade() {
    cat <<EOF
$(out bold Usage:) create upgrade [--verbose]

Upgrades the project's Mojo and Create, from anywhere inside the project, to
their newest releases, changing the versions its pixi.toml allows to match,
then shows how they changed with each one's release notes. Such a release can
change Create's API, so any of the project's code that uses it may need
changes; '$(out command 'create build')' checks that the project still builds. Other packages
in pixi.toml are left as they are.

$(out bold Options:)
  -v, --verbose   Show pixi's output
  -h, --help      Print this help
EOF
}

usage_doctor() {
    cat <<EOF
$(out bold Usage:) create doctor

Checks that pixi is installed, that this machine can run Create, and, inside a
project, which Mojo and Create it uses, then reports the display and GPU.
Exits with an error if something would stop Create from working.
EOF
}

# bad_argument <command> <argument>: dies naming what was wrong with it.
bad_argument() {
    case $2 in
        -*) die "unknown option '$2'; see '$(err command "create $1 --help")'" ;;
        *) die "unexpected argument '$2'; see '$(err command "create $1 --help")'" ;;
    esac
}

require_pixi() {
    command -v pixi >/dev/null 2>&1 \
        || die "pixi is not installed; see https://pixi.sh"
}

# The pixi platform of this machine, if Create supports it.
host_platform() {
    case "$(uname -s) $(uname -m)" in
        "Linux x86_64") echo linux-64 ;;
        "Darwin arm64") echo osx-arm64 ;;
        *) return 1 ;;
    esac
}

require_platform() {
    host_platform >/dev/null \
        || die "Create runs on Linux (x86-64) and macOS (Apple silicon), not on $(uname -s) $(uname -m)"
}

# <text> as the inside of a Mojo string literal.
mojo_string() {
    printf '%s' "$1" | sed 's/[\\"]/\\&/g'
}

# The template for main.mojo; $1 is the window's title, already escaped.
main_mojo() {
    cat <<EOF
# See $GUIDE to get started

from create import *


@fieldwise_init
struct MyApp(Program):
    var logo: Image

    @staticmethod
    def create(mut context: Context, mut canvas: Canvas) raises -> MyApp:
        # Called once: set initial application state and draw the first frame
        return MyApp(Image.load("assets/logo.png"))

    def update(mut self, mut context: Context, mut canvas: Canvas) raises:
        # Called once per frame: handle input, modify state and draw to the screen
        canvas.image(self.logo, (0, 40))
        canvas.font_size(48)
        canvas.text("Create", (0, -110))


def main() raises:
    run[MyApp]("$1")
EOF
}

# quietly <command...>: runs it with its output kept in $log, and shows that
# output if it fails. With --verbose the output is shown as it happens.
quietly() {
    if [ -n "$verbose" ]; then
        "$@"
        return
    fi
    "$@" >"$log" 2>&1 || {
        status=$?
        cat "$log" >&2
        return "$status"
    }
}

# Empties the project directory after a failed `create new`: removes it if
# the command made it, or just its contents if it was already there.
undo_new() {
    rm -f "$log"
    if [ -n "$made_dir" ]; then
        rm -rf -- "$path"
    elif [ -d "$path" ]; then
        (cd "$path" && rm -rf -- ./* ./.[!.]* ./..?*)
    fi
}

cmd_new() {
    verbose=
    path=
    paths=0
    options=1
    for arg; do
        if [ -n "$options" ]; then
            case $arg in
                -h | --help) usage_new; exit 0 ;;
                -v | --verbose) verbose=1; continue ;;
                --) options=; continue ;;
                -*) bad_argument new "$arg" ;;
            esac
        fi
        path=$arg
        paths=$((paths + 1))
    done
    [ "$paths" -eq 1 ] || die "usage: create new [--verbose] <path>"
    case $path in
        '') die "the path is empty" ;;
        *"$nl"*) die "the path has a line break in it" ;;
    esac
    # Drop trailing slashes, but keep / itself.
    while :; do
        case $path in
            ?*/) path=${path%/} ;;
            *) break ;;
        esac
    done

    if [ -e "$path" ]; then
        [ -d "$path" ] || die "'$path' already exists"
        [ -z "$(ls -A "$path")" ] || die "'$path' already exists and is not empty"
        [ -w "$path" ] || die "'$path' is not writable"
        made_dir=
        title=$(cd -- "$path" && pwd -P)
        title=${title##*/}
    else
        made_dir=1
        title=${path##*/}
    fi
    require_pixi
    require_platform

    set --
    for channel in $CHANNELS; do set -- "$@" --channel "$channel"; done
    for platform in $PLATFORMS; do set -- "$@" --platform "$platform"; done

    # A half-made project is removed, so the command can simply be rerun.
    log=$(mktemp)
    trap undo_new EXIT
    trap 'exit 130' INT TERM

    step "Creating new project '$title'"
    quietly pixi init "$@" -- "$path" \
        || die "could not create the project: pixi init failed"
    step "Adding the Mojo and Create pixi packages"
    quietly pixi add --manifest-path "$path/pixi.toml" mojo "$CREATE_SPEC" \
        || die "could not add the Mojo and Create packages: pixi add failed"
    main_mojo "$(mojo_string "$title")" >"$path/main.mojo"
    cp -R -- "$TEMPLATE/." "$path" \
        || die "could not copy the template's files from $TEMPLATE"
    printf '\n# create build output\n/build/\n' >>"$path/.gitignore"

    trap - EXIT INT TERM
    rm -f "$log"
}

# The nearest directory at or above the current one with a pixi.toml and a
# main.mojo; directories with only a pixi.toml, like an enclosing workspace,
# are passed over.
project_root() {
    dir=$(pwd -P)
    while :; do
        if [ -f "$dir/pixi.toml" ] && [ -f "$dir/main.mojo" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        [ "$dir" != / ] || return 1
        dir=$(dirname "$dir")
    done
}

require_project() {
    project_root \
        || die "not in a Create project: no pixi.toml with a main.mojo detected"
}

# "name version" lines for the project's mojo and create, from its lock file;
# nothing if there is no lock file yet.
package_versions() {
    pixi list --manifest-path "$1/pixi.toml" --frozen --no-install \
        --fields name,version '^(mojo|create)$' 2>/dev/null \
        | awk '$1 == "mojo" || $1 == "create" { print $1, $2 }'
}

# Where <name>'s release <version> says what changed.
release_notes() {
    case $1 in
        create) printf 'https://github.com/create-framework/create/releases/tag/v%s\n' "$2" ;;
        mojo) printf 'https://docs.modular.com/mojo/changelog/\n' ;;
    esac
}

# show_changes <root> <before> [notes]: how the project's mojo and create
# changed from <before>, package_versions' output earlier; with notes, each
# changed one's release notes too.
show_changes() {
    package_versions "$1" | while read -r name version; do
        old=$(printf '%s\n' "$2" | awk -v name="$name" '$1 == name { print $2 }')
        if [ "$old" = "$version" ]; then
            printf '  %s\n' "$(out dim "$name $version (unchanged)")"
            continue
        fi
        printf '  %s %s %s' "$name" "$(out dim "${old:-none} ->")" "$(out good "$version")"
        if [ -n "${3-}" ]; then
            printf ' %s' "$(out dim "(release notes: $(release_notes "$name" "$version"))")"
        fi
        printf '\n'
    done
}

# "name version" for each of mojo and create with a newer release than
# pixi.toml allows: what `pixi upgrade` would move it to. Nothing when neither
# has one, or pixi cannot tell.
newer_versions() {
    pixi upgrade --manifest-path "$1/pixi.toml" --dry-run --json mojo create 2>/dev/null \
        | awk '
            /"name":/ { name = $2; gsub(/[",]/, "", name); after = 0 }
            /"after":/ { after = 1 }
            after && /"conda":/ && (name == "mojo" || name == "create") && !(name in seen) {
                # .../create-0.3.0-hb0f4dca_0.conda: the version is between
                # the name and the build string.
                file = $2; gsub(/[",]/, "", file); sub(/.*\//, "", file)
                sub(/-[^-]*$/, "", file); sub(/.*-/, "", file)
                seen[name] = 1
                print name, file
            }' || true
}

# Skips a leading -h/--help (the command's own help) or -- (so the program
# gets everything after it); sets $skip to how many arguments to drop.
program_args() {
    skip=0
    case ${2-} in
        -h | --help) "$1"; exit 0 ;;
        --) skip=1 ;;
    esac
}

cmd_run() {
    program_args usage_run "$@"
    shift "$skip"
    require_pixi
    require_platform
    root=$(require_project)
    cd "$root"
    exec pixi run mojo run main.mojo "$@"
}

cmd_watch() {
    program_args usage_watch "$@"
    shift "$skip"
    require_pixi
    require_platform
    root=$(require_project)
    cd "$root"
    exec pixi exec --spec "$WATCHEXEC_SPEC" -- watchexec \
        --restart --exts mojo --ignore '.pixi/**' --ignore 'build/**' --shell=none \
        -- pixi run mojo run main.mojo "$@"
}

cmd_build() {
    case ${1-} in
        -h | --help) usage_build; exit 0 ;;
    esac
    require_pixi
    require_platform
    root=$(require_project)

    output=
    for arg; do
        case $arg in
            -o | -o?* | --output | --output=*) output=given ;;
        esac
    done
    if [ -z "$output" ]; then
        mkdir -p "$root/build"
        output="$root/build/$(basename "$root")"
        set -- -o "$output" "$@"
    fi

    step "Building project '${root##*/}'"
    # Run from where we are, so a relative -o is relative to here.
    pixi run --manifest-path "$root/pixi.toml" mojo build "$root/main.mojo" "$@"
    [ "$output" = given ] || printf 'Built %s\n' "$(out bold "$output")"
}

cmd_update() {
    verbose=
    for arg; do
        case $arg in
            -h | --help) usage_update; exit 0 ;;
            -v | --verbose) verbose=1 ;;
            *) bad_argument update "$arg" ;;
        esac
    done
    require_pixi
    require_platform
    root=$(require_project)

    before=$(package_versions "$root")
    log=$(mktemp)
    trap 'rm -f "$log"' EXIT
    trap 'exit 130' INT TERM

    step "Updating project '${root##*/}'"
    quietly pixi update --manifest-path "$root/pixi.toml" \
        || die "could not update the project: pixi update failed"

    show_changes "$root" "$before"

    newer=$(newer_versions "$root")
    if [ -n "$newer" ]; then
        if [ "$(printf '%s\n' "$newer" | wc -l)" -eq 1 ]; then
            versions='version' it_is='It is' its='its'
        else
            versions='versions' it_is='They are' its='their'
        fi
        printf '\n%s\n' "$(out warn "New package $versions available:")"
        printf '%s\n' "$newer" | while read -r name version; do
            printf '  %s %s %s\n' "$name" "$(out good "$version")" \
                "$(out dim "(release notes: $(release_notes "$name" "$version"))")"
        done
        printf '\n%s outside the versions pixi.toml allows.\n' "$it_is"
        printf 'See %s release notes for any breaking changes.\n' "$its"
        printf 'To upgrade anyway, use: %s\n' "$(out command 'create upgrade')"
    fi
}

cmd_upgrade() {
    verbose=
    for arg; do
        case $arg in
            -h | --help) usage_upgrade; exit 0 ;;
            -v | --verbose) verbose=1 ;;
            *) bad_argument upgrade "$arg" ;;
        esac
    done
    require_pixi
    require_platform
    root=$(require_project)

    before=$(package_versions "$root")
    log=$(mktemp)
    trap 'rm -f "$log"' EXIT
    trap 'exit 130' INT TERM

    step "Upgrading project '${root##*/}'"
    quietly pixi upgrade --manifest-path "$root/pixi.toml" mojo create \
        || die "could not upgrade the project: pixi upgrade failed"

    show_changes "$root" "$before" notes
    if [ "$(package_versions "$root")" != "$before" ]; then
        printf '\nSee the release notes for any breaking changes, which might require\n'
        printf "updates to the project's code.\n"
    fi
}

cmd_doctor() {
    case ${1-} in
        -h | --help) usage_doctor; exit 0 ;;
    esac
    [ $# -eq 0 ] || bad_argument doctor "$1"

    problems=0
    good() { printf '  %s %-10s %s\n' "$(out good "$mark_good")" "$1" "$2"; }
    note() { printf '  %s %-10s %s\n' "$(out warn "$mark_note")" "$1" "$2"; }
    bad() {
        printf '  %s %-10s %s\n' "$(out bad "$mark_bad")" "$1" "$2"
        problems=$((problems + 1))
    }

    good create-cli "$VERSION"

    have_pixi=
    if command -v pixi >/dev/null 2>&1; then
        have_pixi=1
        good pixi "$(pixi --version | sed 's/^pixi //')"
    else
        bad pixi "not installed; see https://pixi.sh"
    fi

    if platform=$(host_platform); then
        good platform "$platform"
    else
        bad platform "$(uname -s) $(uname -m): Create runs on Linux (x86-64) and macOS (Apple silicon)"
    fi

    if root=$(project_root); then
        good project "$root"
        if [ -n "$have_pixi" ]; then
            versions=$(package_versions "$root" \
                | awk '{ printf "%s%s %s", sep, $1, $2; sep = ", " }')
            if [ -n "$versions" ]; then
                good packages "$versions"
            else
                bad packages "mojo and create are not in the lock file: run '$(out command 'pixi install')' in $root"
            fi
        fi
    else
        note project "not in a project"
    fi

    case $(uname -s) in
        Linux)
            if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
                good display "${WAYLAND_DISPLAY:-${DISPLAY:-}}"
            else
                note display "none: DISPLAY and WAYLAND_DISPLAY are unset, so no window can open"
            fi
            if command -v nvidia-smi >/dev/null 2>&1 \
                && gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -n 1) \
                && [ -n "$gpu" ]; then
                good gpu "$gpu"
            elif [ -e /dev/kfd ]; then
                good gpu "AMD (ROCm)"
            else
                note gpu "no NVIDIA or AMD GPU found"
            fi
            ;;
        Darwin)
            good display "macOS"
            good gpu "Apple silicon (Metal)"
            ;;
    esac

    if [ "$problems" -gt 0 ]; then
        if [ "$problems" -eq 1 ]; then
            printf '\n%s\n' "$(out bad '1 problem found.')"
        else
            printf '\n%s\n' "$(out bad "$problems problems found.")"
        fi
        exit 1
    fi
}

[ $# -gt 0 ] || { color_out=$color_err; usage >&2; exit 1; }
command=$1
shift
case $command in
    new) cmd_new "$@" ;;
    run) cmd_run "$@" ;;
    watch) cmd_watch "$@" ;;
    build) cmd_build "$@" ;;
    update) cmd_update "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    doctor) cmd_doctor "$@" ;;
    -V | --version | version) printf 'create-cli %s\n' "$VERSION" ;;
    -h | --help | help) usage ;;
    *)
        printf "%s unknown command '%s'\n\n" "$(err bad 'create:')" "$command" >&2
        color_out=$color_err
        usage >&2
        exit 1
        ;;
esac
