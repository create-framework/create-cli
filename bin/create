#!/bin/sh
# create: start and run Create projects. Everything is done by pixi.
set -eu

# Replaced with the release's version when the package is built (see
# recipe/recipe.yaml), so the git tag is the one place it is set.
VERSION="dev"

# The channels a project needs: Mojo from Modular's, Create from
# modular-community, and its native libraries from conda-forge.
CHANNELS="https://conda.modular.com/max https://repo.prefix.dev/modular-community conda-forge"

# The platforms Create supports; listing both lets a project made on one solve
# on the other.
PLATFORMS="linux-64 osx-arm64"

# The Create releases the main.mojo template below is written for. New projects
# stay on these even after Create changes its API, so a CLI never makes a
# project that does not build. CI builds the template against the newest
# Create every week (tests/e2e.sh --latest); when that fails, update the
# template and this range together.
CREATE_SPEC="create>=0.1.1,<0.2"

# What `create watch` uses to rerun the program; pixi fetches it on first use.
WATCHEXEC_SPEC="watchexec>=2,<3"

GUIDE="https://github.com/create-framework/create/blob/main/docs/README.md"

nl='
'

# Colour only on a terminal, and never with NO_COLOR set (https://no-color.org).
color_out=
color_err=
if [ -z "${NO_COLOR:-}" ]; then
    if [ -t 1 ]; then color_out=1; fi
    if [ -t 2 ]; then color_err=1; fi
fi

# paint <on> <sgr> <text>
paint() {
    if [ -n "$1" ]; then
        printf '\033[%sm%s\033[0m' "$2" "$3"
    else
        printf '%s' "$3"
    fi
}

die() {
    printf '%s %s\n' "$(paint "$color_err" '1;31' 'create:')" "$1" >&2
    exit 1
}

step() {
    printf '%s %s\n' "$(paint "$color_out" '1;32' '==>')" "$1"
}

usage() {
    cat <<EOF
create-cli $VERSION: start and run Create projects

Usage:
  create new <path>        Make a project at <path> with mojo, create and a main.mojo
  create run [args...]     Run the project's main.mojo, passing args to the program
  create watch [args...]   Run main.mojo, and run it again whenever a .mojo file is saved
  create build [options]   Build main.mojo into an optimised program in build/
  create update            Update Mojo and Create within the versions the project allows
  create doctor            Check pixi, this machine and the project for problems
  create --version         Print the version
  create --help            Print this help

'create <command> --help' tells more about a command.

The user guide: $GUIDE
To update: pixi global update create-cli
EOF
}

usage_new() {
    cat <<EOF
Usage: create new [--verbose] <path>

Makes a project at <path>, which must not exist or be an empty directory
('create new .' makes one in the current directory). The project is a pixi
project with the Modular, modular-community and conda-forge channels, for
Linux (x86-64) and macOS (Apple silicon), with the mojo and create packages
and a main.mojo to start from. If a step fails, nothing is left behind.

Options:
  -v, --verbose   Show pixi's output
  -h, --help      Print this help
EOF
}

usage_run() {
    cat <<EOF
Usage: create run [args...]

Runs the project's main.mojo, from anywhere inside the project, passing args to
the program: 'create run gpu' runs it on the GPU backend. The program runs in
the project's directory, so paths it opens are relative to the project.

To pass --help to the program, put '--' first: create run -- --help
EOF
}

usage_watch() {
    cat <<EOF
Usage: create watch [args...]

Runs the project's main.mojo like 'create run', and restarts it whenever a
.mojo file in the project is saved. Stop it with Ctrl-C. watchexec does the
watching; pixi downloads it the first time.

To pass --help to the program, put '--' first: create watch -- --help
EOF
}

usage_build() {
    cat <<EOF
Usage: create build [mojo build options...]

Builds the project's main.mojo into a program at build/<project name>, which
runs without pixi or Mojo installed on the same platform. Options go to
'mojo build': 'create build -o app' writes the program to ./app instead.
EOF
}

usage_update() {
    cat <<EOF
Usage: create update [--verbose]

Updates the project's packages, like Mojo and Create, from anywhere inside the
project, to the newest releases its pixi.toml allows, then shows how Mojo and
Create changed. The allowed versions stay as they are, so an update never
brings a Create release that could break main.mojo; to move to one, change
create's version in pixi.toml and follow Create's release notes.

Options:
  -v, --verbose   Show pixi's output
  -h, --help      Print this help
EOF
}

usage_doctor() {
    cat <<EOF
Usage: create doctor

Checks that pixi is installed, that this machine can run Create, and, inside a
project, which Mojo and Create it uses, then reports the display and GPU.
Exits with an error if something would stop Create from working.
EOF
}

require_pixi() {
    command -v pixi >/dev/null 2>&1 \
        || die "pixi is not installed; see https://pixi.sh"
}

# The pixi platform of this machine, if Create supports it.
host_platform() {
    case "$(uname -s) $(uname -m)" in
        "Linux x86_64") echo linux-64 ;;
        "Darwin arm64") echo osx-arm64 ;;
        *) return 1 ;;
    esac
}

require_platform() {
    host_platform >/dev/null \
        || die "Create runs on Linux (x86-64) and macOS (Apple silicon), not on $(uname -s) $(uname -m)"
}

# Single quotes <text> for a shell when it needs them.
shell_quote() {
    case $1 in
        *[!A-Za-z0-9_./+-]* | '') printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
        *) printf '%s' "$1" ;;
    esac
}

# <text> as the inside of a Mojo string literal.
mojo_string() {
    printf '%s' "$1" | sed 's/[\\"]/\\&/g'
}

# The template for main.mojo; $1 is the window's title, already escaped.
main_mojo() {
    cat <<EOF
# See $GUIDE to get started

from create import *


@fieldwise_init
struct MyApp(Program):

    @staticmethod
    def create(mut context: Context, mut canvas: Canvas) raises -> MyApp:
        # Called once: set initial application state and draw the first frame
        return MyApp()

    def update(mut self, mut context: Context, mut canvas: Canvas) raises:
        # Called once per frame: handle input, modify state and draw to the screen
        pass


def main() raises:
    run[MyApp]("$1")
EOF
}

# quietly <command...>: runs it with its output kept in $log, and shows that
# output if it fails. With --verbose the output is shown as it happens.
quietly() {
    if [ -n "$verbose" ]; then
        "$@"
        return
    fi
    "$@" >"$log" 2>&1 || {
        status=$?
        cat "$log" >&2
        return "$status"
    }
}

# Empties the project directory after a failed `create new`: removes it if
# the command made it, or just its contents if it was already there.
undo_new() {
    rm -f "$log"
    if [ -n "$made_dir" ]; then
        rm -rf -- "$path"
    elif [ -d "$path" ]; then
        (cd "$path" && rm -rf -- ./* ./.[!.]* ./..?*)
    fi
}

cmd_new() {
    verbose=
    path=
    paths=0
    options=1
    for arg; do
        if [ -n "$options" ]; then
            case $arg in
                -h | --help) usage_new; exit 0 ;;
                -v | --verbose) verbose=1; continue ;;
                --) options=; continue ;;
                -*) die "unknown option '$arg'; see 'create new --help'" ;;
            esac
        fi
        path=$arg
        paths=$((paths + 1))
    done
    [ "$paths" -eq 1 ] || die "usage: create new [--verbose] <path>"
    case $path in
        '') die "the path is empty" ;;
        *"$nl"*) die "the path has a line break in it" ;;
    esac
    # Drop trailing slashes, but keep / itself.
    while :; do
        case $path in
            ?*/) path=${path%/} ;;
            *) break ;;
        esac
    done

    if [ -e "$path" ]; then
        [ -d "$path" ] || die "'$path' already exists"
        [ -z "$(ls -A "$path")" ] || die "'$path' already exists and is not empty"
        [ -w "$path" ] || die "'$path' is not writable"
        made_dir=
        title=$(cd -- "$path" && pwd -P)
        title=${title##*/}
    else
        made_dir=1
        title=${path##*/}
    fi
    require_pixi
    require_platform

    set --
    for channel in $CHANNELS; do set -- "$@" --channel "$channel"; done
    for platform in $PLATFORMS; do set -- "$@" --platform "$platform"; done

    # A half-made project is removed, so the command can simply be rerun.
    log=$(mktemp)
    trap undo_new EXIT
    trap 'exit 130' INT TERM

    step "Making $title"
    quietly pixi init "$@" -- "$path" \
        || die "could not make the project: pixi init failed"
    step "Adding Mojo and Create (the first time, this downloads Mojo and can take a few minutes)"
    quietly pixi add --manifest-path "$path/pixi.toml" mojo "$CREATE_SPEC" \
        || die "could not add mojo and create: pixi add failed"
    main_mojo "$(mojo_string "$title")" >"$path/main.mojo"
    printf '\n# create build output\n/build/\n' >>"$path/.gitignore"

    trap - EXIT INT TERM
    rm -f "$log"

    printf '\nMade %s. To run it:\n\n' "$title"
    [ "$path" = . ] || printf '  cd %s\n' "$(shell_quote "$path")"
    printf '  create run      (or create watch, to rerun it on every save)\n\n'
}

# The nearest directory at or above the current one with a pixi.toml and a
# main.mojo; directories with only a pixi.toml, like an enclosing workspace,
# are passed over.
project_root() {
    dir=$(pwd -P)
    while :; do
        if [ -f "$dir/pixi.toml" ] && [ -f "$dir/main.mojo" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        [ "$dir" != / ] || return 1
        dir=$(dirname "$dir")
    done
}

require_project() {
    project_root \
        || die "not in a Create project: no pixi.toml with a main.mojo here or above"
}

# "name version" lines for the project's mojo and create, from its lock file;
# nothing if there is no lock file yet.
package_versions() {
    pixi list --manifest-path "$1/pixi.toml" --frozen --no-install \
        --fields name,version '^(mojo|create)$' 2>/dev/null \
        | awk '$1 == "mojo" || $1 == "create" { print $1, $2 }'
}

# Skips a leading -h/--help (the command's own help) or -- (so the program
# gets everything after it); sets $skip to how many arguments to drop.
program_args() {
    skip=0
    case ${2-} in
        -h | --help) "$1"; exit 0 ;;
        --) skip=1 ;;
    esac
}

cmd_run() {
    program_args usage_run "$@"
    shift "$skip"
    require_pixi
    require_platform
    root=$(require_project)
    cd "$root"
    exec pixi run mojo run main.mojo "$@"
}

cmd_watch() {
    program_args usage_watch "$@"
    shift "$skip"
    require_pixi
    require_platform
    root=$(require_project)
    cd "$root"
    exec pixi exec --spec "$WATCHEXEC_SPEC" -- watchexec \
        --restart --exts mojo --ignore '.pixi/**' --ignore 'build/**' --shell=none \
        -- pixi run mojo run main.mojo "$@"
}

cmd_build() {
    case ${1-} in
        -h | --help) usage_build; exit 0 ;;
    esac
    require_pixi
    require_platform
    root=$(require_project)

    output=
    for arg; do
        case $arg in
            -o | -o?* | --output | --output=*) output=given ;;
        esac
    done
    if [ -z "$output" ]; then
        mkdir -p "$root/build"
        output="$root/build/$(basename "$root")"
        set -- -o "$output" "$@"
    fi

    # Run from where we are, so a relative -o is relative to here.
    pixi run --manifest-path "$root/pixi.toml" mojo build "$root/main.mojo" "$@"
    [ "$output" = given ] || printf 'Built %s\n' "$output"
}

cmd_update() {
    verbose=
    for arg; do
        case $arg in
            -h | --help) usage_update; exit 0 ;;
            -v | --verbose) verbose=1 ;;
            *) die "usage: create update [--verbose]" ;;
        esac
    done
    require_pixi
    require_platform
    root=$(require_project)

    before=$(package_versions "$root")
    log=$(mktemp)
    trap 'rm -f "$log"' EXIT
    trap 'exit 130' INT TERM

    step "Updating ${root##*/}"
    quietly pixi update --manifest-path "$root/pixi.toml" \
        || die "could not update the project: pixi update failed"

    package_versions "$root" | while read -r name version; do
        old=$(printf '%s\n' "$before" | awk -v name="$name" '$1 == name { print $2 }')
        if [ "$old" = "$version" ]; then
            printf '  %s %s (unchanged)\n' "$name" "$version"
        else
            printf '  %s %s -> %s\n' "$name" "${old:-none}" "$version"
        fi
    done
}

cmd_doctor() {
    case ${1-} in
        -h | --help) usage_doctor; exit 0 ;;
    esac
    [ $# -eq 0 ] || die "usage: create doctor"

    problems=0
    good() { printf '  %s %-10s %s\n' "$(paint "$color_out" 32 ok)" "$1" "$2"; }
    note() { printf '  %s %-10s %s\n' "$(paint "$color_out" 33 '--')" "$1" "$2"; }
    bad() {
        printf '  %s %-10s %s\n' "$(paint "$color_out" 31 '!!')" "$1" "$2"
        problems=$((problems + 1))
    }

    good create-cli "$VERSION"

    have_pixi=
    if command -v pixi >/dev/null 2>&1; then
        have_pixi=1
        good pixi "$(pixi --version | sed 's/^pixi //')"
    else
        bad pixi "not installed; see https://pixi.sh"
    fi

    if platform=$(host_platform); then
        good platform "$platform"
    else
        bad platform "$(uname -s) $(uname -m): Create runs on Linux (x86-64) and macOS (Apple silicon)"
    fi

    if root=$(project_root); then
        good project "$root"
        if [ -n "$have_pixi" ]; then
            versions=$(package_versions "$root" \
                | awk '{ printf "%s%s %s", sep, $1, $2; sep = ", " }')
            if [ -n "$versions" ]; then
                good packages "$versions"
            else
                bad packages "mojo and create are not in the lock file: run 'pixi install' in $root"
            fi
        fi
    else
        note project "not in a project"
    fi

    case $(uname -s) in
        Linux)
            if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
                good display "${WAYLAND_DISPLAY:-${DISPLAY:-}}"
            else
                note display "none: DISPLAY and WAYLAND_DISPLAY are unset, so no window can open"
            fi
            if command -v nvidia-smi >/dev/null 2>&1 \
                && gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -n 1) \
                && [ -n "$gpu" ]; then
                good gpu "$gpu"
            elif [ -e /dev/kfd ]; then
                good gpu "AMD (ROCm)"
            else
                note gpu "no NVIDIA or AMD GPU found"
            fi
            ;;
        Darwin)
            good display "macOS"
            good gpu "Apple silicon (Metal)"
            ;;
    esac

    if [ "$problems" -gt 0 ]; then
        printf '\n%s problem(s) found.\n' "$problems"
        exit 1
    fi
}

[ $# -gt 0 ] || { usage >&2; exit 1; }
command=$1
shift
case $command in
    new) cmd_new "$@" ;;
    run) cmd_run "$@" ;;
    watch) cmd_watch "$@" ;;
    build) cmd_build "$@" ;;
    update) cmd_update "$@" ;;
    doctor) cmd_doctor "$@" ;;
    -V | --version | version) printf 'create-cli %s\n' "$VERSION" ;;
    -h | --help | help) usage ;;
    *) printf 'create: unknown command %s\n\n' "'$command'" >&2; usage >&2; exit 1 ;;
esac
